    "Skips anything password managers and other apps mark as confidential or temporary.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta tutto ciò che i gestori di password e altre app segnano come riservato o temporaneo."
