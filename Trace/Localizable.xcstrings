    "This shortcut is already used by another app. Please choose a different one.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa scorciatoia è già usata da un'altra app. Scegline un'altra."
          }
        }
      }
    },
    "To record what you copy, allow Trace in Privacy & Security › Paste from Other Apps.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per registrare ciò che copi, consenti Trace in Privacy e sicurezza › Incolla da altre app."
          }
        }
      }
    },
    "Trace": {
      "shouldTranslate": false
    },
    "Trace lives in your menu bar and remembers what you copy: text, links, images and files.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trace vive nella barra dei menu e ricorda ciò che copi: testo, link, immagini e file."
          }
        }
      }
    },
    "Trace needs Accessibility access to paste for you.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trace ha bisogno dell'accesso Accessibilità per incollare al posto tuo."
