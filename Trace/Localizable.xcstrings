    },
    "A tiny, fast clipboard history for your Mac.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cronologia degli appunti minuscola e veloce per il tuo Mac."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Info"
          }
        }
      }
    },
    "About Trace": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Informazioni su Trace"
          }
        }
      }
    },
    "Add App…": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi app…"
          }
        }
      }
    },
    "All items except pinned ones will be deleted. This can't be undone.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli elementi tranne quelli fissati verranno eliminati. L'operazione non può essere annullata."
          }
        }
      }
    },
    "Allow Accessibility access so the item you choose is pasted right away.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l'accesso Accessibilità così l'elemento scelto viene incollato subito."
          }
        }
      }
    },
    "Allow clipboard access": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l'accesso agli appunti"
